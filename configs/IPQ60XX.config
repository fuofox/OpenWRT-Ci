## ============================================================
## 京东云雅典娜 AX6600（re-cs-02）精简版配置
## 替换 fuofox/OpenWRT-Ci 仓库的 configs/IPQ60XX.config 整个文件
## 说明：
##  - fuofox 的 IPQ60XX.config 已只含雅典娜（本就是雅典娜专用线，无需再删机型）
##  - DEVICE_PACKAGES 已填入全家桶（无 Docker 版，已移除 Dae/daed）
##    要带 Docker：把下面那行换成 athena-devices-packages.diff 里的方案 B 串
##  - NSS / ATH11K 满血配置原样保留
##  - Dae/daed 已从本方案移除（eBPF 编译门槛过高）
##  - HomeProxy 已替换为 Re:HomeProxy（1andrevich/homeproxy-hiddify）：包名 luci-app-re-homeproxy / luci-i18n-re-homeproxy-zh_Hans；代理核心刷后由 LuCI「Core & Tools」在线装
## ============================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn luci-theme-argon luci-app-argon-config luci-theme-fluent luci-app-adguardhome luci-i18n-adguardhome-zh-cn luci-app-re-homeproxy luci-i18n-re-homeproxy-zh_Hans luci-app-openclash luci-app-passwall luci-i18n-passwall-zh-cn luci-app-passwall2 luci-i18n-passwall2-zh-cn luci-app-nikki-rs luci-i18n-nikki-rs-zh-cn luci-app-momo luci-i18n-momo-zh-cn luci-app-clashoo luci-i18n-clashoo-zh-cn luci-app-tailscale luci-i18n-tailscale-zh-cn luci-app-cloudflared luci-i18n-cloudflared-zh-cn luci-app-pushbot luci-i18n-pushbot-zh-cn"

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y

## athena-led 由截图里的 =m 改为 =y，确保编进 rootfs
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y
